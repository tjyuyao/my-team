{
  "simulation": {
    "tick_duration": {
      "value": 10,
      "unit": "seconds"
    },
    "simulation_time_per_tick": {
      "value": 1,
      "unit": "hour"
    },
    "start_paused": false,
    "deterministic_mode": true
  },
  "agents": [
    {
      "agent_id": "agent.root",
      "display_name": "Root Agent",
      "role": "root_decision_agent",
      "parent_id": null,
      "children": ["agent.research", "agent.planning", "agent.review"],
      "tools": ["read", "write", "ls", "delegate"],
      "can_delegate": true,
      "shared_kb_permissions": [
        {
          "scope": "project/*",
          "principal": "agent.root",
          "allow": ["list", "read"]
        },
        {
          "scope": "decisions/*",
          "principal": "agent.root",
          "allow": ["list", "read", "create", "write", "publish"]
        }
      ]
    },
    {
      "agent_id": "agent.research",
      "display_name": "Research Agent",
      "role": "research_manager",
      "parent_id": "agent.root",
      "children": ["agent.web_research", "agent.data_analysis"],
      "tools": ["read", "write", "ls", "delegate", "send_email"],
      "can_delegate": true,
      "shared_kb_permissions": [
        {
          "scope": "project/research/*",
          "principal": "agent.research",
          "allow": ["list", "read", "create", "write", "append", "lock", "unlock"]
        }
      ]
    },
    {
      "agent_id": "agent.planning",
      "display_name": "Planning Agent",
      "role": "planning_manager",
      "parent_id": "agent.root",
      "children": [],
      "tools": ["read", "write", "ls", "send_email"],
      "can_delegate": false,
      "shared_kb_permissions": [
        {
          "scope": "project/planning/*",
          "principal": "agent.planning",
          "allow": ["list", "read", "create", "write", "append", "lock", "unlock"]
        }
      ]
    },
    {
      "agent_id": "agent.review",
      "display_name": "Review Agent",
      "role": "review_manager",
      "parent_id": "agent.root",
      "children": ["agent.quality_check"],
      "tools": ["read", "write", "ls", "delegate", "send_email"],
      "can_delegate": true,
      "shared_kb_permissions": [
        {
          "scope": "project/deliverables/*",
          "principal": "agent.review",
          "allow": ["list", "read"]
        }
      ]
    },
    {
      "agent_id": "agent.web_research",
      "display_name": "Web Research Agent",
      "role": "web_researcher",
      "parent_id": "agent.research",
      "children": [],
      "tools": ["read", "write", "ls", "send_email", "web_search"],
      "can_delegate": false,
      "shared_kb_permissions": [
        {
          "scope": "project/research/*",
          "principal": "agent.web_research",
          "allow": ["list", "read", "create", "write", "append"]
        }
      ]
    },
    {
      "agent_id": "agent.data_analysis",
      "display_name": "Data Analysis Agent",
      "role": "data_analyst",
      "parent_id": "agent.research",
      "children": [],
      "tools": ["read", "write", "ls", "send_email"],
      "can_delegate": false,
      "shared_kb_permissions": [
        {
          "scope": "project/research/*",
          "principal": "agent.data_analysis",
          "allow": ["list", "read", "create", "write", "append"]
        }
      ]
    },
    {
      "agent_id": "agent.quality_check",
      "display_name": "Quality Check Agent",
      "role": "quality_check_agent",
      "parent_id": "agent.review",
      "children": [],
      "tools": ["read", "write", "ls", "send_email"],
      "can_delegate": false,
      "shared_kb_permissions": [
        {
          "scope": "project/deliverables/*",
          "principal": "agent.quality_check",
          "allow": ["list", "read"]
        }
      ]
    }
  ],
  "policies": {
    "max_delegation_depth": 5,
    "email_delivery_latency_ticks": 1,
    "default_lock_lease_ticks": 4,
    "max_retries": 3,
    "private_storage_limit_mb": 512
  }
}
