{
  "simulation": {
    "name": "default",
    "tick_duration_value": 10,
    "tick_duration_unit": "seconds",
    "simulation_time_per_tick_value": 1,
    "simulation_time_per_tick_unit": "hour",
    "start_paused": false,
    "deterministic_mode": true,
    "max_delegation_depth": 5,
    "email_delivery_latency_ticks": 1,
    "default_lock_lease_ticks": 4,
    "max_retries": 3,
    "private_storage_limit_mb": 512
  },
  "execution": {
    "execution_mode": "discrete_async",
    "max_llm_calls_per_activation": 1,
    "max_tool_calls_per_activation": 8,
    "max_action_budget": 32,
    "max_micro_loop_rounds": 3
  },
  "llm_profiles": {
    "default": {
      "provider": "openai",
      "model": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.7,
      "max_tokens": 4096
    },
    "research": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "api_key_env": "ANTHROPIC_API_KEY",
      "temperature": 0.5,
      "max_tokens": 8192
    },
    "fast": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.3,
      "max_tokens": 2048
    }
  },
  "agents": [
    {
      "agent_id": "agent.root",
      "display_name": "Root Agent",
      "role": "root_decision_agent",
      "parent_id": null,
      "children": ["agent.research", "agent.planning"],
      "tools": ["read", "write", "ls", "delegate"],
      "can_delegate": true,
      "bootstrap": true,
      "llm_profile": "default"
    },
    {
      "agent_id": "agent.research",
      "display_name": "Research Agent",
      "role": "research_manager",
      "parent_id": "agent.root",
      "children": ["agent.web_research", "agent.data_analysis"],
      "tools": ["read", "write", "ls", "delegate", "send_email"],
      "can_delegate": true,
      "bootstrap": false,
      "llm_profile": "research"
    },
    {
      "agent_id": "agent.planning",
      "display_name": "Planning Agent",
      "role": "planning_manager",
      "parent_id": "agent.root",
      "children": [],
      "tools": ["read", "write", "ls", "send_email"],
      "can_delegate": false,
      "bootstrap": false,
      "llm_profile": "default"
    },
    {
      "agent_id": "agent.web_research",
      "display_name": "Web Research Agent",
      "role": "web_researcher",
      "parent_id": "agent.research",
      "children": [],
      "tools": ["read", "write", "ls", "send_email", "web_search"],
      "can_delegate": false,
      "bootstrap": false,
      "llm_profile": "fast"
    },
    {
      "agent_id": "agent.data_analysis",
      "display_name": "Data Analysis Agent",
      "role": "data_analyst",
      "parent_id": "agent.research",
      "children": [],
      "tools": ["read", "write", "ls", "send_email"],
      "can_delegate": false,
      "bootstrap": false,
      "llm_profile": "fast"
    }
  ],
  "policies": {
    "max_delegation_depth": 5,
    "email_delivery_latency_ticks": 1,
    "default_lock_lease_ticks": 4,
    "max_retries": 3,
    "private_storage_limit_mb": 512
  }
}
